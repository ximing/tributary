# 每个环境一份文件，变量名相同。开发读 .env，测试只读 .env.test，
# 生产在 NODE_ENV=production 时先读 .env.production 再读 .env。
PORT=8788
DATABASE_URL=postgresql://tributary_app:password@222.128.65.91:25432/tributary_test
BOOTSTRAP_DATABASE_URL=
APP_DB_PASSWORD=
MEILI_HOST=http://222.128.65.91:7700
MEILI_API_KEY=
MEILI_INDEX_UID=tributary_nodes_test

# 对象存储（S3 兼容，与 inwit 同一 endpoint/region/鉴权）。
# 桶：生产 tributary，开发/测试 tributary-test；可用 S3_BUCKET 显式覆盖。
S3_ENDPOINT=https://s3.aimo.plus
S3_REGION=cn-beijing
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
