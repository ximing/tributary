{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "支流",
  "version": "0.1.0",
  "identifier": "plus.aimo.fenzhi",
  "build": {
    "frontendDist": "https://fenzhi.aimo.plus"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "支流",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
