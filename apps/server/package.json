{
  "name": "@tributary/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "start:worker": "NODE_ENV=production tsx src/worker.ts",
    "migrate": "NODE_ENV=production tsx src/migrate.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.integration.config.ts src/conversations/tree.integration.test.ts",
    "test:agent": "vitest run --config vitest.integration.config.ts src/agent/ask.integration.test.ts",
    "test:meili": "vitest run --config vitest.integration.config.ts src/search/meili.integration.test.ts",
    "bootstrap": "tsx scripts/bootstrap-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@tributary/domain": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.2.1",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
