# Production env for docker-compose.prod.yml on the app host.
#   cp .env.production.example .env
# Fill every change-me. .env is gitignored.
# Postgres and Meilisearch are reached on the db host's LAN address.

NODE_ENV=production
PORT=8788
HOST=0.0.0.0
TRIBUTARY_IMAGE_TAG=stable

DATABASE_URL=postgresql://tributary_app:change-me@192.168.9.109:5432/tributary_prod
MEILI_HOST=http://192.168.9.109:7700
MEILI_API_KEY=change-me
MEILI_INDEX_UID=tributary_nodes_prod

S3_ENDPOINT=https://s3.aimo.plus
S3_REGION=cn-beijing
S3_BUCKET=tributary
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
